# ── Servidor ─────────────────────────────────────────────
PORT=8087
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/calio_notifications

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_URL=amqp://calio:calio123@localhost:5672
RABBITMQ_EXCHANGE=calio.events
RABBITMQ_QUEUE=notification.queue

# ── Firebase Cloud Messaging ─────────────────────────────
# Ruta al archivo de credenciales del Service Account de Firebase.
# Si no se configura, el servicio sigue funcionando pero solo
# registra el log "push simulado" en vez de enviar de verdad.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_ENABLED=false

# ── JWT (si Gateway reenvía el token para validar el usuario) ──
JWT_SECRET=cali0-super-secret-key-for-jwt-signing-256bits!!

# COLOCAR LOS DATOS REALES ESTA ES UNA DE SIMULACION